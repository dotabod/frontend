{
  "name": "dotabod-frontend",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "format": "vp fmt",
    "dev": "doppler run -- next dev",
    "pull": "doppler run -- npx prisma db pull",
    "pull:tunnel": "./scripts/db-tunnel.sh npx prisma db pull",
    "push": "doppler run -- npx prisma db push",
    "push:tunnel": "./scripts/db-tunnel.sh npx prisma db push",
    "studio": "doppler run -- npx prisma studio",
    "studio:tunnel": "./scripts/db-tunnel.sh npx prisma studio",
    "build": "prisma generate && prisma generate --schema=./prisma-mongo/schema.prisma && next build",
    "build-local": "doppler run -- npm run build",
    "start": "next start",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "typecheck": "tsc --noEmit",
    "parse": "i18next -c ./i18next-parser.config.mjs",
    "postinstall": "npm run generate:all && lefthook install || true",
    "knip": "knip",
    "test": "npm run vitest",
    "test:watch": "npm run vitest watch",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=4096' npm run vitest run --coverage",
    "vitest": "vp test run",
    "generate:postgres": "npx prisma generate",
    "generate:mongo": "npx prisma generate --schema=./prisma-mongo/schema.prisma",
    "generate:all": "npm run generate:postgres && npm run generate:mongo",
    "mongo:pull": "doppler run -- npx prisma db pull --schema=./prisma-mongo/schema.prisma",
    "mongo:push": "doppler run -- npx prisma db push --schema=./prisma-mongo/schema.prisma",
    "mongo:studio": "doppler run -- npx prisma studio --schema=./prisma-mongo/schema.prisma"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.3.4",
    "@csstools/postcss-oklab-function": "^5.0.9",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@mantine/core": "^9.5.2",
    "@mantine/form": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@next/third-parties": "^16.3.4",
    "@nowpaymentsio/nowpayments-api-js": "^1.0.5",
    "@prisma/client": "^7.10.0",
    "@reduxjs/toolkit": "^2.11.0",
    "@sentry/nextjs": "^10.73.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@twurple/eventsub-base": "8.1.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.5",
    "antd": "^6.6.2",
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "curse-filter": "^7.0.0",
    "dayjs": "^1.11.23",
    "dotaconstants": "github:dotabod/dotaconstants#70fffb95a5951dae2ea80b183c8c1170a52da6f1",
    "focus-visible": "^5.2.1",
    "framer-motion": "^13.1.1",
    "graphql-request": "^7.3.5",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.37.0",
    "mantine-flagpack": "^4.1.1",
    "next": "^16.3.4",
    "next-auth": "4.24.15",
    "next-mdx-remote": "^6.0.0",
    "node-fetch": "^3.3.2",
    "obs-websocket-js": "^5.0.7",
    "opennode": "^2.0.1",
    "postcss-focus-visible": "^11.0.0",
    "react": "19.2.8",
    "react-countdown": "^2.3.6",
    "react-countdown-circle-timer": "^3.2.1",
    "react-dom": "19.2.8",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "retry": "^0.13.1",
    "socket.io-client": "^4.8.1",
    "stripe": "22.6.0",
    "styled-components": "^6.5.3",
    "swr": "^2.5.1",
    "tailwindcss": "^4.3.3",
    "twitch-fetcher": "https://github.com/dotabod/twitch-fetcher.git",
    "use-debounce": "^10.0.6",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.4.0",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/retry": "^0.12.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "@voidzero-dev/vite-plus-test": "npm:vitest@5.0.0",
    "happy-dom": "^20.13.2",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "node-mocks-http": "^1.18.1",
    "postcss": "^8.5.28",
    "prisma": "^7.10.0",
    "ts-morph": "^28.0.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest",
    "vitest": "5.0.0"
  },
  "overrides": {
    "@voidzero-dev/vite-plus-test": "npm:vitest@5.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "5.0.0"
  },
  "browserslist": "defaults, not ie <= 11",
  "packageManager": "pnpm@11.2.2"
}
